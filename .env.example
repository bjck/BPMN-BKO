# Copy to .env and set values. .env is gitignored.

# AI chat (optional)
GEMINI_API_KEY=

# Kafka: uncomment and set to true when using Kafka service tasks or BPMN events. Start Kafka first: docker compose -f docker/docker-compose.dev.yml up -d
# BPMN_KAFKA_ENABLED=true
# SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# BPMN_KAFKA_TOPIC=bpmn-events
# BPMN_KAFKA_CONSUMER_GROUP=bpmn-engine
