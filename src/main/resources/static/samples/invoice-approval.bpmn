<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:engine="https://bko.dev/schema/bpmn-engine/1.0">

  <bpmn:process id="Process_InvoiceApproval" name="Invoice Approval Workflow">

    <!-- ══ START ══ -->
    <bpmn:startEvent id="StartEvent_1" name="Invoice Received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Step 1: Validate invoice structure and totals -->
    <bpmn:serviceTask id="Task_ValidateInvoice" name="Validate Invoice" implementation="validate-invoice">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Validation gate -->
    <bpmn:exclusiveGateway id="GW_Validate" name="Invoice Valid?" default="Flow_Invalid">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFetch</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- BRANCH DOWN: invalid invoice terminates immediately -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Invoice Rejected">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel fetch: vendor + PO lookup concurrently -->
    <bpmn:parallelGateway id="GW_FetchFork" name="Fetch Data">
      <bpmn:incoming>Flow_ToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVendor</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToPO</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- BRANCH UP: Vendor lookup -->
    <bpmn:serviceTask id="Task_LookupVendor" name="Lookup Vendor" implementation="rest">
      <bpmn:incoming>Flow_ToVendor</bpmn:incoming>
      <bpmn:outgoing>Flow_VendorDone</bpmn:outgoing>
      <bpmn:extensionElements>
        <engine:taskConfiguration
          type="rest"
          method="GET"
          url="https://httpbin.org/anything"
          authenticationType="bearer"
          bearerToken="${erpApiToken}"
          resultVariable="vendorData"
          timeoutSeconds="10"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- BRANCH DOWN: Purchase Order lookup -->
    <bpmn:serviceTask id="Task_LookupPO" name="Lookup Purchase Order" implementation="rest">
      <bpmn:incoming>Flow_ToPO</bpmn:incoming>
      <bpmn:outgoing>Flow_PODone</bpmn:outgoing>
      <bpmn:extensionElements>
        <engine:taskConfiguration
          type="rest"
          method="GET"
          url="https://httpbin.org/anything"
          authenticationType="bearer"
          bearerToken="${erpApiToken}"
          resultVariable="poData"
          timeoutSeconds="10"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Join parallel fetch branches -->
    <bpmn:parallelGateway id="GW_FetchJoin" name="Data Ready">
      <bpmn:incoming>Flow_VendorDone</bpmn:incoming>
      <bpmn:incoming>Flow_PODone</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMatch</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Step 2: Compare invoice amounts to PO -->
    <bpmn:serviceTask id="Task_MatchInvoice" name="Match Invoice to PO" implementation="match-invoice">
      <bpmn:incoming>Flow_ToMatch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMatchGW</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- PO match gate -->
    <bpmn:exclusiveGateway id="GW_Match" name="PO Matches?" default="Flow_ToDiscrepancy">
      <bpmn:incoming>Flow_ToMatchGW</bpmn:incoming>
      <bpmn:outgoing>Flow_Matched</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToDiscrepancy</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- BRANCH DOWN: AP Manager resolves discrepancy manually -->
    <bpmn:userTask id="UserTask_ResolveDiscrepancy" name="Resolve PO Discrepancy" camunda:assignee="ap-manager">
      <bpmn:incoming>Flow_ToDiscrepancy</bpmn:incoming>
      <bpmn:outgoing>Flow_DiscrepancyDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- High-value approval gate (implicit merge from matched + discrepancy-resolved) -->
    <bpmn:exclusiveGateway id="GW_HighValue" name="Amount > $10,000?" default="Flow_AutoApprove">
      <bpmn:incoming>Flow_Matched</bpmn:incoming>
      <bpmn:incoming>Flow_DiscrepancyDone</bpmn:incoming>
      <bpmn:outgoing>Flow_NeedsApproval</bpmn:outgoing>
      <bpmn:outgoing>Flow_AutoApprove</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- BRANCH UP: Finance Director sign-off for high-value invoices -->
    <bpmn:userTask id="UserTask_DirectorApproval" name="Director Approval" camunda:assignee="finance-director">
      <bpmn:incoming>Flow_NeedsApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_DirectorDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Step 3: Post journal entry to General Ledger -->
    <!-- Implicit exclusive merge: receives from auto-approve OR director-approval -->
    <bpmn:serviceTask id="Task_PostGL" name="Post to General Ledger" implementation="rest">
      <bpmn:incoming>Flow_AutoApprove</bpmn:incoming>
      <bpmn:incoming>Flow_DirectorDone</bpmn:incoming>
      <bpmn:outgoing>Flow_GLDone</bpmn:outgoing>
      <bpmn:extensionElements>
        <engine:taskConfiguration
          type="rest"
          method="POST"
          url="https://httpbin.org/anything"
          authenticationType="bearer"
          bearerToken="${erpApiToken}"
          body="${{'invoiceId': invoiceId, 'vendorId': vendorId, 'amount': amount, 'poNumber': poNumber, 'description': 'AP Invoice ' + invoiceId}}"
          resultVariable="glEntry"
          timeoutSeconds="15"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 4: Publish invoice-approved domain event -->
    <bpmn:serviceTask id="Task_PublishApproved" name="Publish Invoice Approved" implementation="kafka">
      <bpmn:incoming>Flow_GLDone</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishDone</bpmn:outgoing>
      <bpmn:extensionElements>
        <engine:taskConfiguration
          type="kafka"
          topic="invoice-events"
          messageMapping="${{'eventType': 'INVOICE_APPROVED', 'invoiceId': invoiceId, 'vendorId': vendorId, 'amount': amount, 'poNumber': poNumber}}"
          keyMapping="${invoiceId}"
          resultVariable="kafkaApprovedResult"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 5: Schedule payment in payment system -->
    <bpmn:serviceTask id="Task_SchedulePayment" name="Schedule Payment" implementation="rest">
      <bpmn:incoming>Flow_PublishDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ScheduleDone</bpmn:outgoing>
      <bpmn:extensionElements>
        <engine:taskConfiguration
          type="rest"
          method="POST"
          url="https://httpbin.org/anything"
          authenticationType="bearer"
          bearerToken="${paymentsApiToken}"
          body="${{'invoiceId': invoiceId, 'vendorId': vendorId, 'amount': amount}}"
          resultVariable="paymentRef"
          timeoutSeconds="15"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Step 6: Publish payment-scheduled domain event -->
    <bpmn:serviceTask id="Task_PublishScheduled" name="Publish Payment Scheduled" implementation="kafka">
      <bpmn:incoming>Flow_ScheduleDone</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
      <bpmn:extensionElements>
        <engine:taskConfiguration
          type="kafka"
          topic="payment-events"
          messageMapping="${{'eventType': 'PAYMENT_SCHEDULED', 'invoiceId': invoiceId, 'vendorId': vendorId, 'amount': amount}}"
          keyMapping="${invoiceId}"
          resultVariable="kafkaScheduledResult"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- ══ END ══ -->
    <bpmn:endEvent id="EndEvent_1" name="Invoice Processed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ══ Sequence Flows ══ -->
    <bpmn:sequenceFlow id="Flow_1"               sourceRef="StartEvent_1"                targetRef="Task_ValidateInvoice"/>
    <bpmn:sequenceFlow id="Flow_2"               sourceRef="Task_ValidateInvoice"         targetRef="GW_Validate"/>
    <bpmn:sequenceFlow id="Flow_ToFetch"         sourceRef="GW_Validate"                 targetRef="GW_FetchFork">
      <bpmn:conditionExpression>${valid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid"         sourceRef="GW_Validate"                 targetRef="EndEvent_Rejected"/>
    <bpmn:sequenceFlow id="Flow_ToVendor"        sourceRef="GW_FetchFork"                targetRef="Task_LookupVendor"/>
    <bpmn:sequenceFlow id="Flow_ToPO"            sourceRef="GW_FetchFork"                targetRef="Task_LookupPO"/>
    <bpmn:sequenceFlow id="Flow_VendorDone"      sourceRef="Task_LookupVendor"           targetRef="GW_FetchJoin"/>
    <bpmn:sequenceFlow id="Flow_PODone"          sourceRef="Task_LookupPO"               targetRef="GW_FetchJoin"/>
    <bpmn:sequenceFlow id="Flow_ToMatch"         sourceRef="GW_FetchJoin"                targetRef="Task_MatchInvoice"/>
    <bpmn:sequenceFlow id="Flow_ToMatchGW"       sourceRef="Task_MatchInvoice"           targetRef="GW_Match"/>
    <bpmn:sequenceFlow id="Flow_Matched"         sourceRef="GW_Match"                    targetRef="GW_HighValue">
      <bpmn:conditionExpression>${matched == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToDiscrepancy"   sourceRef="GW_Match"                    targetRef="UserTask_ResolveDiscrepancy"/>
    <bpmn:sequenceFlow id="Flow_DiscrepancyDone" sourceRef="UserTask_ResolveDiscrepancy" targetRef="GW_HighValue"/>
    <bpmn:sequenceFlow id="Flow_NeedsApproval"   sourceRef="GW_HighValue"                targetRef="UserTask_DirectorApproval">
      <bpmn:conditionExpression>${amount > 10000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AutoApprove"     sourceRef="GW_HighValue"                targetRef="Task_PostGL"/>
    <bpmn:sequenceFlow id="Flow_DirectorDone"    sourceRef="UserTask_DirectorApproval"   targetRef="Task_PostGL"/>
    <bpmn:sequenceFlow id="Flow_GLDone"          sourceRef="Task_PostGL"                 targetRef="Task_PublishApproved"/>
    <bpmn:sequenceFlow id="Flow_PublishDone"     sourceRef="Task_PublishApproved"        targetRef="Task_SchedulePayment"/>
    <bpmn:sequenceFlow id="Flow_ScheduleDone"    sourceRef="Task_SchedulePayment"        targetRef="Task_PublishScheduled"/>
    <bpmn:sequenceFlow id="Flow_End"             sourceRef="Task_PublishScheduled"       targetRef="EndEvent_1"/>

  </bpmn:process>

  <!--
    Layout key:
      Main happy path  → horizontal centre (y=280)
      Up   (+branch)   → Director Approval                    (y=100)
      Down (-branch)   → Rejected end event · PO discrepancy  (y=420)
      Parallel fork    → Vendor lookup up (y=100), PO lookup down (y=420)
  -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane bpmnElement="Process_InvoiceApproval" id="BPMNPlane_1">

      <!-- ══ SHAPES — main line ══ -->
      <bpmndi:BPMNShape bpmnElement="StartEvent_1" id="BPMNShape_StartEvent_1">
        <dc:Bounds x="82" y="262" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_ValidateInvoice" id="BPMNShape_Task_ValidateInvoice">
        <dc:Bounds x="180" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_Validate" id="BPMNShape_GW_Validate">
        <dc:Bounds x="365" y="255" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_FetchFork" id="BPMNShape_GW_FetchFork">
        <dc:Bounds x="515" y="255" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_FetchJoin" id="BPMNShape_GW_FetchJoin">
        <dc:Bounds x="775" y="255" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_MatchInvoice" id="BPMNShape_Task_MatchInvoice">
        <dc:Bounds x="890" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_Match" id="BPMNShape_GW_Match">
        <dc:Bounds x="1055" y="255" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_HighValue" id="BPMNShape_GW_HighValue">
        <dc:Bounds x="1235" y="255" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_PostGL" id="BPMNShape_Task_PostGL">
        <dc:Bounds x="1410" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_PublishApproved" id="BPMNShape_Task_PublishApproved">
        <dc:Bounds x="1580" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_SchedulePayment" id="BPMNShape_Task_SchedulePayment">
        <dc:Bounds x="1750" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_PublishScheduled" id="BPMNShape_Task_PublishScheduled">
        <dc:Bounds x="1920" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="EndEvent_1" id="BPMNShape_EndEvent_1">
        <dc:Bounds x="2092" y="262" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- ══ SHAPES — upper branches ══ -->
      <!-- Vendor lookup (parallel, above main) -->
      <bpmndi:BPMNShape bpmnElement="Task_LookupVendor" id="BPMNShape_Task_LookupVendor">
        <dc:Bounds x="620" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- Director approval (high-value, above main) -->
      <bpmndi:BPMNShape bpmnElement="UserTask_DirectorApproval" id="BPMNShape_UserTask_DirectorApproval">
        <dc:Bounds x="1210" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- ══ SHAPES — lower branches ══ -->
      <!-- Invoice rejected end event (invalid invoice, below main) -->
      <bpmndi:BPMNShape bpmnElement="EndEvent_Rejected" id="BPMNShape_EndEvent_Rejected">
        <dc:Bounds x="372" y="422" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <!-- PO lookup (parallel, below main) -->
      <bpmndi:BPMNShape bpmnElement="Task_LookupPO" id="BPMNShape_Task_LookupPO">
        <dc:Bounds x="620" y="380" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- AP Manager resolves discrepancy (below main) -->
      <bpmndi:BPMNShape bpmnElement="UserTask_ResolveDiscrepancy" id="BPMNShape_UserTask_ResolveDiscrepancy">
        <dc:Bounds x="1030" y="380" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- ══ EDGES — main happy path ══ -->
      <bpmndi:BPMNEdge bpmnElement="Flow_1" id="BPMNEdge_Flow_1">
        <di:waypoint x="118" y="280"/>
        <di:waypoint x="180" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_2" id="BPMNEdge_Flow_2">
        <di:waypoint x="280" y="280"/>
        <di:waypoint x="365" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_ToFetch" id="BPMNEdge_Flow_ToFetch">
        <di:waypoint x="415" y="280"/>
        <di:waypoint x="515" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_ToMatch" id="BPMNEdge_Flow_ToMatch">
        <di:waypoint x="825" y="280"/>
        <di:waypoint x="890" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_ToMatchGW" id="BPMNEdge_Flow_ToMatchGW">
        <di:waypoint x="990" y="280"/>
        <di:waypoint x="1055" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Matched" id="BPMNEdge_Flow_Matched">
        <di:waypoint x="1105" y="280"/>
        <di:waypoint x="1235" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_AutoApprove" id="BPMNEdge_Flow_AutoApprove">
        <di:waypoint x="1285" y="280"/>
        <di:waypoint x="1410" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_GLDone" id="BPMNEdge_Flow_GLDone">
        <di:waypoint x="1510" y="280"/>
        <di:waypoint x="1580" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_PublishDone" id="BPMNEdge_Flow_PublishDone">
        <di:waypoint x="1680" y="280"/>
        <di:waypoint x="1750" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_ScheduleDone" id="BPMNEdge_Flow_ScheduleDone">
        <di:waypoint x="1850" y="280"/>
        <di:waypoint x="1920" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_End" id="BPMNEdge_Flow_End">
        <di:waypoint x="2020" y="280"/>
        <di:waypoint x="2092" y="280"/>
      </bpmndi:BPMNEdge>

      <!-- ══ EDGES — parallel fetch (up and down from fork/join) ══ -->
      <bpmndi:BPMNEdge bpmnElement="Flow_ToVendor" id="BPMNEdge_Flow_ToVendor">
        <di:waypoint x="540" y="255"/>
        <di:waypoint x="540" y="100"/>
        <di:waypoint x="620" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_ToPO" id="BPMNEdge_Flow_ToPO">
        <di:waypoint x="540" y="305"/>
        <di:waypoint x="540" y="420"/>
        <di:waypoint x="620" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_VendorDone" id="BPMNEdge_Flow_VendorDone">
        <di:waypoint x="720" y="100"/>
        <di:waypoint x="800" y="100"/>
        <di:waypoint x="800" y="255"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_PODone" id="BPMNEdge_Flow_PODone">
        <di:waypoint x="720" y="420"/>
        <di:waypoint x="800" y="420"/>
        <di:waypoint x="800" y="305"/>
      </bpmndi:BPMNEdge>

      <!-- ══ EDGES — lower branches ══ -->
      <!-- Invalid invoice → rejected -->
      <bpmndi:BPMNEdge bpmnElement="Flow_Invalid" id="BPMNEdge_Flow_Invalid">
        <di:waypoint x="390" y="305"/>
        <di:waypoint x="390" y="422"/>
      </bpmndi:BPMNEdge>
      <!-- PO mismatch → discrepancy user task (down) then back up to high-value gate -->
      <bpmndi:BPMNEdge bpmnElement="Flow_ToDiscrepancy" id="BPMNEdge_Flow_ToDiscrepancy">
        <di:waypoint x="1080" y="305"/>
        <di:waypoint x="1080" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_DiscrepancyDone" id="BPMNEdge_Flow_DiscrepancyDone">
        <di:waypoint x="1130" y="420"/>
        <di:waypoint x="1260" y="420"/>
        <di:waypoint x="1260" y="305"/>
      </bpmndi:BPMNEdge>

      <!-- ══ EDGES — upper branch ══ -->
      <!-- High-value → director approval (up) then back down to GL task -->
      <bpmndi:BPMNEdge bpmnElement="Flow_NeedsApproval" id="BPMNEdge_Flow_NeedsApproval">
        <di:waypoint x="1260" y="255"/>
        <di:waypoint x="1260" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_DirectorDone" id="BPMNEdge_Flow_DirectorDone">
        <di:waypoint x="1310" y="100"/>
        <di:waypoint x="1460" y="100"/>
        <di:waypoint x="1460" y="240"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
